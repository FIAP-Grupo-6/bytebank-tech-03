# ─── Firebase (Configurações do projeto → Seus apps → Configuração do SDK) ───
# O prefixo EXPO_PUBLIC_ é obrigatório: é o que expõe a variável ao bundle.
# Estas chaves são públicas por design — quem protege os dados são as Security
# Rules em firebase/firestore.rules.

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ─── Supabase (Project Settings → API) ─────────────────────────────────────
# Usado só para o bucket de recibos — auth e banco continuam no Firebase.
# A anon key é pública por design — quem protege o bucket são as policies em
# supabase/storage-policies.sql.

EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
